<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for Developer ID builds (docs/RELEASE.md). Deliberately minimal:
  microphone for push-to-talk MyBuddy Voice. Screen Recording and Accessibility are TCC permissions the user
  grants in System Settings, not entitlements. No App Sandbox (the LAN listener, ScreenCaptureKit and
  CGEvent injection are used outside it); no JIT, unsigned-memory or library-validation exceptions.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
