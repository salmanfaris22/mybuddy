    "clipboard.request": { "dir": "BOTH", "channel": "control", "capability": "clipboard.sync",
      "payload": { "revisionId": {"type": "uuid"} } },
    "clipboard.content": { "dir": "BOTH", "channel": "control", "capability": "clipboard.sync",
      "payload": { "revisionId": {"type": "uuid"}, "text": {"type": "string", "min": 0, "max": 65536, "unit": "utf8Bytes"} } },
