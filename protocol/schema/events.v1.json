    "voice.intent.approved": { "dir": "P2M", "channel": "control", "capability": "voice.commands",
      "payload": { "utteranceId": {"type": "uuid"}, "intentId": {"type": "string", "min": 1, "max": 64}, "decision": {"type": "enum", "values": ["approve", "deny"]} } },
    "voice.intent.result": { "dir": "M2P", "channel": "control", "capability": "voice.commands",
      "payload": { "utteranceId": {"type": "uuid"}, "intentId": {"type": "string", "min": 1, "max": 64}, "status": {"type": "enum", "values": ["succeeded", "failed", "denied", "needs_permission"]}, "spokenSummary": {"type": "string", "max": 500} } },
    "voice.cancelled": { "dir": "BOTH", "channel": "control", "capability": "voice.commands",
      "payload": { "utteranceId": {"type": "uuid"} } },

    "health.snapshot.request": { "dir": "P2M", "channel": "control", "capability": "health.read",
