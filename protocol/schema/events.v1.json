{
  "version": 1,
  "comment": "Event catalog for Envelope v1. dir: P2M (phone to Mac), M2P (Mac to phone), BOTH. A type with both payloadP2M and payloadM2P is a request (P2M) / result (M2P) pair. Field spec: string{min,max}, enum{values}, number{min,max}, integer{min,max}, bool, uuid, hex64, b64u{maxBytes}, array{items,min,max}, object. Fields are required unless optional:true.",
  "limits": {
    "control": 65536,
    "input": 1024,
    "file": 131072,
    "signaling": 49152
  },
  "capabilities": [
    "screen.view", "input.control", "apps.launch", "files.browse", "files.transfer",
    "clipboard.sync", "notifications.mirror", "voice.commands", "ai.chat", "ai.agent",
    "ai.screen_analysis", "health.read", "notes.sync", "unattended"
  ],
  "keyCodes": [
    "KeyA", "KeyB", "KeyC", "KeyD", "KeyE", "KeyF", "KeyG", "KeyH", "KeyI", "KeyJ", "KeyK", "KeyL", "KeyM",
    "KeyN", "KeyO", "KeyP", "KeyQ", "KeyR", "KeyS", "KeyT", "KeyU", "KeyV", "KeyW", "KeyX", "KeyY", "KeyZ",
    "Digit0", "Digit1", "Digit2", "Digit3", "Digit4", "Digit5", "Digit6", "Digit7", "Digit8", "Digit9",
    "Enter", "Escape", "Backspace", "Tab", "Space", "Minus", "Equal", "BracketLeft", "BracketRight",
    "Backslash", "Semicolon", "Quote", "Backquote", "Comma", "Period", "Slash", "CapsLock",
    "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12",
    "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End", "PageUp", "PageDown", "Delete",
    "ShiftLeft", "ShiftRight", "ControlLeft", "ControlRight", "AltLeft", "AltRight", "MetaLeft", "MetaRight"
  ],
  "events": {
    "pairing.request": { "dir": "P2M", "channel": "control", "capability": null, "core": true,
      "payload": { "deviceName": {"type": "string", "min": 1, "max": 64}, "platform": {"type": "enum", "values": ["android", "macos"]}, "appVersion": {"type": "string", "min": 1, "max": 32} } },
    "pairing.approved": { "dir": "M2P", "channel": "control", "capability": null, "core": true,
      "payload": { "hostDeviceId": {"type": "string", "min": 32, "max": 32}, "hostName": {"type": "string", "min": 1, "max": 64}, "grantedCapabilities": {"type": "array", "items": "capability", "max": 16} } },
    "pairing.rejected": { "dir": "M2P", "channel": "control", "capability": null, "core": true,
      "payload": { "reason": {"type": "enum", "values": ["user_rejected", "expired", "invalid_proof", "rate_limited", "window_closed"]} } },
    "session.request": { "dir": "P2M", "channel": "control", "capability": null, "core": true,
      "payload": { "requestedCapabilities": {"type": "array", "items": "capability", "max": 16}, "protocolVersions": {"type": "array", "items": "integer", "min": 1, "max": 8}, "features": {"type": "array", "items": "string", "max": 64} } },
    "session.approved": { "dir": "M2P", "channel": "control", "capability": null, "core": true,
      "payload": { "grantedCapabilities": {"type": "array", "items": "capability", "max": 16}, "protocolVersion": {"type": "integer", "min": 1, "max": 1}, "features": {"type": "array", "items": "string", "max": 64}, "heartbeatIntervalMs": {"type": "integer", "min": 1000, "max": 60000}, "sharedFolders": {"type": "array", "optional": true, "max": 32, "items": {"type": "object", "fields": { "rootId": {"type": "string", "min": 1, "max": 64}, "name": {"type": "string", "min": 1, "max": 255} }}}, "agentWorkspaces": {"type": "array", "optional": true, "max": 16, "items": {"type": "object", "fields": { "workspaceId": {"type": "string", "min": 1, "max": 64}, "name": {"type": "string", "min": 1, "max": 255} }}}, "agents": {"type": "array", "optional": true, "max": 4, "items": {"type": "object", "fields": { "kind": {"type": "enum", "values": ["claude_code", "codex"]}, "ready": {"type": "bool"} }}} } },
    "session.rejected": { "dir": "M2P", "channel": "control", "capability": null, "core": true,
      "payload": { "reason": {"type": "enum", "values": ["not_trusted", "revoked", "busy", "user_rejected", "host_locked"]} } },
    "session.closed": { "dir": "BOTH", "channel": "control", "capability": null, "core": true,
      "payload": { "reason": {"type": "enum", "values": ["user", "emergency_stop", "revoked", "timeout", "error", "host_sleep", "app_quit"]} } },
    "host.heartbeat": { "dir": "BOTH", "channel": "control", "capability": null, "core": true,
      "payload": { "probe": {"type": "string", "min": 1, "max": 64}, "reply": {"type": "bool"} } },
    "host.status": { "dir": "M2P", "channel": "control", "capability": null, "core": true,
      "payload": { "hostName": {"type": "string", "min": 1, "max": 64}, "osVersion": {"type": "string", "min": 1, "max": 64}, "appVersion": {"type": "string", "min": 1, "max": 32}, "screenSharing": {"type": "bool"}, "inputControl": {"type": "bool"}, "activeCapabilities": {"type": "array", "items": "capability", "max": 16} } },
    "error": { "dir": "BOTH", "channel": "control", "capability": null, "core": true,
      "payload": { "code": {"type": "string", "min": 1, "max": 64}, "message": {"type": "string", "min": 0, "max": 512}, "retryable": {"type": "bool"} } },

    "connect.offer": { "dir": "M2P", "channel": "control", "capability": null, "core": true,
      "payload": { "serverUrl": {"type": "string", "min": 8, "max": 256}, "hostDeviceId": {"type": "string", "min": 32, "max": 32}, "createdAt": {"type": "string", "min": 20, "max": 40} } },
    "connect.enroll": { "dir": "P2M", "channel": "control", "capability": null, "core": true,
      "payload": { "clientDeviceId": {"type": "string", "min": 32, "max": 32}, "createdAt": {"type": "string", "min": 20, "max": 40}, "clientSignature": {"type": "b64u", "maxBytes": 80} } },
    "connect.enrolled": { "dir": "M2P", "channel": "control", "capability": null, "core": true,
      "payload": { "pairingId": {"type": "string", "min": 1, "max": 64}, "serverUrl": {"type": "string", "min": 8, "max": 256} } },

    "webrtc.offer": { "dir": "M2P", "channel": "signaling", "capability": "screen.view",
      "payload": { "sdp": {"type": "string", "min": 1, "max": 32768} } },
    "webrtc.answer": { "dir": "P2M", "channel": "signaling", "capability": "screen.view",
      "payload": { "sdp": {"type": "string", "min": 1, "max": 32768} } },
    "webrtc.ice": { "dir": "BOTH", "channel": "signaling", "capability": "screen.view",
      "payload": { "candidate": {"type": "string", "min": 0, "max": 1024, "optional": true}, "sdpMid": {"type": "string", "min": 0, "max": 32, "optional": true}, "sdpMLineIndex": {"type": "integer", "min": 0, "max": 15, "optional": true}, "endOfCandidates": {"type": "bool", "optional": true} } },

    "screen.start": { "dir": "P2M", "channel": "control", "capability": "screen.view",
      "payload": { "quality": {"type": "enum", "values": ["auto", "smooth", "high", "balanced", "low"], "optional": true}, "displayId": {"type": "string", "min": 1, "max": 32, "optional": true}, "maxFps": {"type": "integer", "min": 5, "max": 60, "optional": true} } },
    "screen.update": { "dir": "P2M", "channel": "control", "capability": "screen.view",
      "payload": { "quality": {"type": "enum", "values": ["auto", "smooth", "high", "balanced", "low"], "optional": true}, "displayId": {"type": "string", "min": 1, "max": 32, "optional": true}, "maxFps": {"type": "integer", "min": 5, "max": 60, "optional": true} } },
    "screen.stop": { "dir": "P2M", "channel": "control", "capability": "screen.view",
      "payload": { "reason": {"type": "enum", "values": ["user", "background", "error"], "optional": true} } },
    "screen.state": { "dir": "M2P", "channel": "control", "capability": "screen.view",
      "payload": { "state": {"type": "enum", "values": ["starting", "awaiting_selection", "live", "stopped", "failed"]}, "reason": {"type": "string", "min": 1, "max": 64, "pattern": "^[a-z0-9_]+$", "optional": true}, "message": {"type": "string", "min": 0, "max": 300, "optional": true}, "quality": {"type": "enum", "values": ["auto", "smooth", "high", "balanced", "low"], "optional": true}, "tier": {"type": "enum", "values": ["smooth", "high", "balanced", "low"], "optional": true}, "displayId": {"type": "string", "min": 1, "max": 32, "optional": true}, "width": {"type": "integer", "min": 2, "max": 8192, "optional": true}, "height": {"type": "integer", "min": 2, "max": 8192, "optional": true}, "fps": {"type": "integer", "min": 1, "max": 60, "optional": true}, "source": {"type": "enum", "values": ["display", "window", "application", "test_pattern"], "optional": true}, "displays": {"type": "array", "optional": true, "max": 16, "items": {"type": "object", "fields": {"displayId": {"type": "string", "min": 1, "max": 32}, "name": {"type": "string", "min": 1, "max": 64}, "width": {"type": "integer", "min": 1, "max": 16384}, "height": {"type": "integer", "min": 1, "max": 16384}, "main": {"type": "bool"}}}} } },

    "input.pointer": { "dir": "P2M", "channel": "input", "capability": "input.control",
      "payload": { "x": {"type": "number", "min": 0, "max": 1}, "y": {"type": "number", "min": 0, "max": 1}, "displayId": {"type": "string", "min": 1, "max": 32}, "action": {"type": "enum", "values": ["move"]} } },
    "input.button": { "dir": "P2M", "channel": "input", "capability": "input.control",
      "payload": { "button": {"type": "enum", "values": ["left", "right", "middle"]}, "action": {"type": "enum", "values": ["down", "up", "click", "doubleClick"]}, "x": {"type": "number", "min": 0, "max": 1}, "y": {"type": "number", "min": 0, "max": 1}, "displayId": {"type": "string", "min": 1, "max": 32} } },
    "input.scroll": { "dir": "P2M", "channel": "input", "capability": "input.control",
      "payload": { "dx": {"type": "number", "min": -2000, "max": 2000}, "dy": {"type": "number", "min": -2000, "max": 2000}, "unit": {"type": "enum", "values": ["pixel", "line"]} } },
    "input.key": { "dir": "P2M", "channel": "input", "capability": "input.control",
      "payload": { "code": {"type": "enum", "values": "$keyCodes"}, "action": {"type": "enum", "values": ["down", "up", "press"]}, "modifiers": {"type": "array", "items": {"type": "enum", "values": ["shift", "control", "option", "command"]}, "max": 4} } },
    "input.text": { "dir": "P2M", "channel": "input", "capability": "input.control",
      "payload": { "text": {"type": "string", "min": 1, "max": 256, "unit": "unicodeScalars", "noControlExcept": ["\n", "\t"]} } },

    "host.app.list": { "dir": "BOTH", "channel": "control", "capability": "apps.launch",
      "payloadP2M": { "query": {"type": "string", "min": 0, "max": 100, "optional": true}, "limit": {"type": "integer", "min": 1, "max": 200} },
      "payloadM2P": { "apps": {"type": "array", "max": 200, "items": {"type": "object", "fields": { "bundleId": {"type": "string", "min": 1, "max": 255}, "name": {"type": "string", "min": 1, "max": 255}, "isRunning": {"type": "bool"} }}} } },
    "host.app.open": { "dir": "BOTH", "channel": "control", "capability": "apps.launch",
      "payloadP2M": { "bundleId": {"type": "string", "min": 3, "max": 255, "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"} },
      "payloadM2P": { "bundleId": {"type": "string", "min": 3, "max": 255}, "status": {"type": "enum", "values": ["opened", "not_found", "denied", "failed"]} } },
    "host.file.list": { "dir": "BOTH", "channel": "control", "capability": "files.browse",
      "payloadP2M": { "rootId": {"type": "string", "min": 1, "max": 64}, "path": {"type": "string", "min": 0, "max": 1024, "noNul": true} },
      "payloadM2P": { "rootId": {"type": "string", "min": 1, "max": 64}, "path": {"type": "string", "min": 0, "max": 1024}, "entries": {"type": "array", "max": 1000, "items": {"type": "object", "fields": { "name": {"type": "string", "min": 1, "max": 255}, "kind": {"type": "enum", "values": ["file", "folder"]}, "size": {"type": "integer", "min": 0, "optional": true}, "modifiedAt": {"type": "string", "max": 40, "optional": true} }}} } },
    "host.file.open": { "dir": "BOTH", "channel": "control", "capability": "files.browse",
      "payloadP2M": { "rootId": {"type": "string", "min": 1, "max": 64}, "path": {"type": "string", "min": 1, "max": 1024, "noNul": true} },
      "payloadM2P": { "rootId": {"type": "string", "min": 1, "max": 64}, "path": {"type": "string", "min": 1, "max": 1024}, "status": {"type": "enum", "values": ["opened", "not_found", "denied", "failed"]} } },

    "file.offer": { "dir": "BOTH", "channel": "control", "capability": "files.transfer",
      "payload": { "transferId": {"type": "uuid"}, "name": {"type": "string", "min": 1, "max": 255, "fileName": true}, "size": {"type": "integer", "min": 1, "max": 2147483648}, "sha256": {"type": "hex64"}, "chunkSize": {"type": "integer", "min": 16384, "max": 65536}, "mimeType": {"type": "string", "max": 128, "optional": true}, "requestId": {"type": "uuid", "optional": true} } },
    "file.request": { "dir": "P2M", "channel": "control", "capability": "files.transfer",
      "payload": { "requestId": {"type": "uuid"}, "rootId": {"type": "string", "min": 1, "max": 64}, "path": {"type": "string", "min": 1, "max": 1024, "noNul": true} } },
    "file.start": { "dir": "BOTH", "channel": "control", "capability": "files.transfer",
      "payload": { "transferId": {"type": "uuid"}, "fromChunk": {"type": "integer", "min": 0, "max": 131072} } },
    "file.chunk": { "dir": "BOTH", "channel": "file", "capability": "files.transfer",
      "payload": { "transferId": {"type": "uuid"}, "index": {"type": "integer", "min": 0, "max": 131072}, "data": {"type": "b64u", "maxBytes": 65536} } },
    "file.ack": { "dir": "BOTH", "channel": "control", "capability": "files.transfer",
      "payload": { "transferId": {"type": "uuid"}, "index": {"type": "integer", "min": 0, "max": 131072} } },
    "file.pause": { "dir": "BOTH", "channel": "control", "capability": "files.transfer",
      "payload": { "transferId": {"type": "uuid"} } },
    "file.resume": { "dir": "BOTH", "channel": "control", "capability": "files.transfer",
      "payload": { "transferId": {"type": "uuid"} } },
    "file.cancel": { "dir": "BOTH", "channel": "control", "capability": "files.transfer",
      "payload": { "transferId": {"type": "uuid"}, "reason": {"type": "string", "max": 256, "optional": true} } },
    "file.complete": { "dir": "BOTH", "channel": "control", "capability": "files.transfer",
      "payload": { "transferId": {"type": "uuid"}, "sha256": {"type": "hex64"} } },
    "file.error": { "dir": "BOTH", "channel": "control", "capability": "files.transfer",
      "payload": { "transferId": {"type": "uuid"}, "code": {"type": "enum", "values": ["checksum_mismatch", "too_large", "disk_full", "denied", "timeout", "invalid_chunk", "cancelled"]} } },

