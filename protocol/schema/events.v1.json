      "payload": { "format": {"type": "enum", "values": ["json", "markdown"]}, "redacted": {"type": "bool"}, "exportedAt": {"type": "string", "min": 1, "max": 40} } },

    "notification.posted": { "dir": "BOTH", "channel": "control", "capability": "notifications.mirror",
      "payload": { "notificationId": {"type": "string", "min": 1, "max": 128}, "appPackage": {"type": "string", "min": 1, "max": 255}, "appLabel": {"type": "string", "min": 1, "max": 128}, "title": {"type": "string", "max": 256, "optional": true}, "text": {"type": "string", "max": 1024, "optional": true}, "postedAt": {"type": "string", "min": 1, "max": 40}, "redaction": {"type": "enum", "values": ["none", "partial", "title_only", "content_hidden"]}, "category": {"type": "string", "min": 1, "max": 32, "optional": true} } },
    "notification.removed": { "dir": "BOTH", "channel": "control", "capability": "notifications.mirror",
