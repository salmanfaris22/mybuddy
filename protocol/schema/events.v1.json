    "clipboard.paused": { "dir": "BOTH", "channel": "control", "capability": "clipboard.sync",
      "payload": { "paused": {"type": "bool"} } },

    "ai.provider.status": { "dir": "M2P", "channel": "control", "capability": "ai.chat",
      "payload": { "mode": {"type": "enum", "values": ["chat", "agent"]}, "providerId": {"type": "string", "min": 1, "max": 64}, "providerKind": {"type": "string", "min": 1, "max": 64}, "displayName": {"type": "string", "min": 1, "max": 64}, "modelId": {"type": "string", "max": 128, "optional": true}, "privacyLabel": {"type": "string", "min": 1, "max": 128}, "localOnly": {"type": "bool"}, "availability": {"type": "enum", "values": ["available", "unavailable", "not_configured", "not_authorized"]}, "detail": {"type": "string", "max": 256, "optional": true} } },
    "ai.request": { "dir": "P2M", "channel": "control", "capability": "ai.chat",
