# Copy to .env (git-ignored) and edit. Nothing secret belongs here — secrets are generated into
# ./secrets by scripts/init-secrets.sh.
MYBUDDY_DOMAIN=connect.example.com
MYBUDDY_ACME_EMAIL=admin@example.com
# Usually the same host as MYBUDDY_DOMAIN; it must resolve to this server's public IP.
MYBUDDY_TURN_HOST=connect.example.com
