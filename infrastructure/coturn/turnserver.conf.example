# MyBuddy TURN relay (coturn). scripts/init-secrets.sh renders this into secrets/turnserver.conf,
# filling in the shared secret, realm and public IP. Media relayed here stays DTLS-SRTP encrypted end-to-end between the
# phone and the Mac; TURN only forwards ciphertext when a direct path is impossible.

listening-port=3478
# turns: on 5349 needs a certificate; see README ("TURN over TLS").
# tls-listening-port=5349
# cert=/etc/coturn/certs/fullchain.pem
# pkey=/etc/coturn/certs/privkey.pem

# Short-lived credentials minted by connect-api (TURN REST API: HMAC-SHA1 over "<expiry>:<deviceId>").
use-auth-secret
static-auth-secret=__TURN_SECRET__
realm=__TURN_REALM__
fingerprint

external-ip=__PUBLIC_IP__
min-port=49160
max-port=49200

# Abuse limits.
total-quota=100
user-quota=12
max-bps=3000000
stale-nonce=600
no-software-attribute
no-rfc5780
no-stun-backward-compatibility
response-origin-only-with-rfc5780

# Never relay into private, loopback, link-local or reserved ranges: TURN must not become a proxy
# into the server's own network.
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=240.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=64:ff9b::-64:ff9b::ffff:ffff
denied-peer-ip=::ffff:0.0.0.0-::ffff:255.255.255.255
denied-peer-ip=100::-100::ffff:ffff:ffff:ffff
denied-peer-ip=2001::-2001:1ff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=2002::-2002:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

no-cli
no-tlsv1
no-tlsv1_1
log-file=stdout
simple-log
